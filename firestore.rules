rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Único dono (UID fixo do painel). Ninguém mais lê nada.
    function isOwner() {
      return request.auth != null &&
        request.auth.uid == 'PHdDffbZc1ZjfgguBQoSKEHvJ273';
    }

    // users: o usuário anônimo cria o próprio doc (id = uid) e atualiza name/lastSeen.
    // Apenas o dono pode ler.
    match /users/{uid} {
      allow create, update: if request.auth != null && request.auth.uid == uid;
      allow read: if isOwner();
      allow delete: if false;
    }

    // sessions / errors: qualquer usuário logado (anônimo) pode criar; só o dono lê.
    match /sessions/{id} {
      allow create: if request.auth != null;
      allow read: if isOwner();
      allow update, delete: if false;
    }
    match /errors/{id} {
      allow create: if request.auth != null;
      allow read: if isOwner();
      allow update, delete: if false;
    }
  }
}
